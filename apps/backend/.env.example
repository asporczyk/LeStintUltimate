PORT=3000
MONGO_URI=mongodb://localhost:27017/stint-planner
# Optional: comma-separated allowed browser origins (replaces the defaults in src/cors.ts)
# CORS_ORIGINS=https://stint.example.com
# Optional: requests per minute per IP (all routes / creating and deleting races)
# RATE_LIMIT_MAX=300
# RATE_LIMIT_RACE_WRITE_MAX=20
# Optional: proxies trusted when finding the client IP for rate limits (hop count or addresses);
# default: private network addresses, which fits Render
# TRUST_PROXY=loopback, linklocal, uniquelocal
